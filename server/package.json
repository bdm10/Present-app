{
  "name": "present-server",
  "version": "1.0.0",
  "private": true,
  "description": "Backend for Present: daily personalised guided meditations",
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo:bundle": "tsx scripts/make-bundled-demo.ts ../ios/Present/Resources/DemoSession"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@fastify/multipart": "^9.4.0",
    "fastify": "^5.12.7",
    "luxon": "^3.7.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
