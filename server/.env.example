# ─── Present backend configuration ─────────────────────────────────────────────
# Copy to .env for local runs (`cp .env.example .env`), or set these as secrets on
# your host (e.g. `fly secrets set KEY=value`). Never put real keys in the iOS app.

# Required in production: a long random string the iPhone app uses to sign in.
# Generate one with:  openssl rand -base64 32
APP_TOKEN=

# Where the database, generated audio and uploads are stored.
DATA_DIR=./data
PORT=8787

# ─── Script writing (Claude) ───────────────────────────────────────────────────
# Without this key, Present uses pre-written demo scripts.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high. Medium is plenty for a short creative script.
ANTHROPIC_EFFORT=medium
# Used only to estimate spend (USD per million tokens). Update if pricing changes.
ANTHROPIC_USD_PER_MTOK_IN=4
ANTHROPIC_USD_PER_MTOK_OUT=20

# ─── Narration (ElevenLabs) ────────────────────────────────────────────────────
# Without this key, Present uses an offline demo voice for the demo scripts only.
ELEVENLABS_API_KEY=
# eleven_v4 (most expressive, GA since Sept 2026), eleven_v3, eleven_multilingual_v2, ...
ELEVENLABS_MODEL=eleven_v4
# Optional: voice to use until you pick one in the app, and a shortlist to show.
ELEVENLABS_DEFAULT_VOICE_ID=
ELEVENLABS_VOICE_IDS=
# v4 honours stability and similarity only. Higher stability = calmer, more even delivery.
ELEVENLABS_STABILITY=0.65
ELEVENLABS_SIMILARITY=0.8
# Used only to estimate spend. Check https://elevenlabs.io/pricing/api for your plan.
ELEVENLABS_USD_PER_1K_CHARS=0.08

# ─── Spending limits ───────────────────────────────────────────────────────────
# Generation stops (with a clear message in the app) once this month's estimated
# spend would pass the limit. Daily sessions and extra sessions both count.
MONTHLY_SPEND_LIMIT_USD=15
# Maximum extra (on-demand) sessions per day.
DAILY_ON_DEMAND_LIMIT=4

# ─── Daily scheduling ──────────────────────────────────────────────────────────
# Generation starts this many minutes before your chosen "ready by" time.
DAILY_LEAD_MINUTES=30
# If the server was down at the scheduled time, still generate up to this many hours late.
CATCH_UP_HOURS=12
MAX_JOB_ATTEMPTS=4

# ─── Push notifications (optional; needs a paid Apple Developer account) ───────
# Create an APNs key at developer.apple.com → Certificates, IDs & Profiles → Keys.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.present.meditation
# Paste the .p8 contents (newlines as \n) or point to the file.
APNS_KEY_P8=
APNS_KEY_PATH=

# Testing only: force demo providers even when keys are present.
FORCE_DEMO=false
